# Copy to .env and fill in. See README.md § Environment for the full table.

# --- Privy dashboard ---
NEXT_PUBLIC_PRIVY_APP_ID=                # Privy dashboard — safe for the client bundle
PRIVY_APP_SECRET=                        # Privy dashboard — server-only, never in a client bundle
PRIVY_AUTHORIZATION_KEY=                 # Privy dashboard — server-side wallet/policy actions (key-quorum signing)
PRIVY_WEBHOOK_SECRET=                    # Privy dashboard — deposit webhook signing key (svix, `whsec_...`)
PRIVY_SPLITTER_AUTHORIZATION_KEY=        # P-256 private key of the splitter's session signer (FR-3.3) — generated by `pnpm --filter @bolt/privy phase3:split`
SIMULATOR_AUTHORIZATION_KEY=             # SERVER ONLY. P-256 private key of the /simulator sandbox's key quorum (FR-9.4) — generated by `pnpm --filter @bolt/privy phase9:simulator`. Owns the sandbox and nothing else: it cannot authorize a request against any real business's wallet or policy.
BOLT_OPERATING_WALLET_ID=                # Privy wallet id of the business's OPERATING account — the wallet the splitter signs from

# --- Arc ---
ARC_RPC_URL=https://rpc.testnet.arc.io   # arc-docs — Arc testnet RPC
ARC_CHAIN_ID=5042002                     # arc-docs — Arc testnet chain id

# Arc mainnet — deliberately blank. arc-docs (/arc/concepts/deployment-model.mdx,
# re-checked 2026-09-11) lists Private Mainnet and Public Mainnet as "Upcoming",
# and /arc/references/rpc-endpoints.mdx says mainnet endpoints and parameters are
# published separately when available. Fill both in and `pnpm contracts:deploy:mainnet`
# runs the same contracts/scripts/deploy.ts against mainnet with no code change.
ARC_MAINNET_RPC_URL=                     # unpublished — do not guess
ARC_MAINNET_CHAIN_ID=                    # unpublished — do not guess

# --- Circle ---
USDC_ADDRESS=0x3600000000000000000000000000000000000000  # Circle — Arc testnet USDC (also Arc's native gas token)
CIRCLE_API_KEY=                          # Circle — CCTP payouts (Phase 8)

# --- BoltRegistry ---
# output of `pnpm contracts:deploy` (hardhat run scripts/deploy.ts --network arcTestnet)
REGISTRY_ADDRESS=0x654713c0554cf3286e140c876e49f15b3f9da0cd  # verified: https://testnet.arcscan.app/address/0x654713c0554cf3286e140c876e49f15b3f9da0cd#code

# --- BoltUnlockTimer (Phase 6, FR-5.4 — the 24h cool-off) ---
# output of `hardhat run scripts/deploy-unlock-timer.ts --network arcTestnet`
UNLOCK_TIMER_ADDRESS=0xda6528d75e1c576e36c17f7012a7f0ffad49b82e

# --- Contracts deploy (local only — not read by the app at runtime) ---
# Only needed in contracts/.. /.env to run `pnpm contracts:deploy` yourself.
# Never commit a real value for DEPLOYER_PRIVATE_KEY.
DEPLOYER_ADDRESS=                        # funded with Arc testnet USDC (gas)
DEPLOYER_PRIVATE_KEY=                    # local only — signs the BoltRegistry deploy tx

# --- Postgres ---
DATABASE_URL=                            # any Postgres — `pnpm db:push` applies packages/db's Drizzle schema

# --- The Graph ---
GRAPH_API_KEY=                           # Subgraph Studio (Phase 4)
SUBGRAPH_URL=                            # Subgraph Studio query URL (Phase 4)

# --- Monitor agent (Phase 7) ---
# The Monitor's only data source is SUBGRAPH_URL above. Everything here is optional:
# without OPENROUTER_API_KEY the loop, /health and /findings all still work, and
# /ask returns 503 with the fully-assembled evidence bundle. See apps/monitor/README.md.
# Swapped from Anthropic to OpenRouter (OpenAI-compatible endpoint), per user direction.
OPENROUTER_API_KEY=                      # OpenRouter — only the /ask reasoning step needs it
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
MONITOR_BUSINESSES=acme-marketplace,bolt-unlock-demo
MONITOR_PORT=4000
MONITOR_INTERVAL_MS=60000

# --- World ---
# Divergence from the pre-code plan, flagged per Rule 0: IDKit 4.x needs FOUR
# values, not the two this file originally listed. `app_id` alone is not enough —
# proof requests must be signed by the RP signing key, and proofs are verified
# against `rp_id`. See docs/WORLD_FEEDBACK.md §(b).
#   world-docs /world-id/idkit/integrate.mdx steps 2–5
WORLD_APP_ID=                            # `app_xxx` — Developer Portal (Phase 6/8)
WORLD_RP_ID=                             # `rp_xxx`  — Developer Portal; the path segment of POST /api/v4/verify/{rp_id}
WORLD_RP_SIGNING_KEY=                    # SERVER ONLY. Shown once at RP registration; signs proof requests. Never NEXT_PUBLIC_*.
WORLD_ACTION_ID=                         # the action string proofs are scoped to, e.g. "bolt-unlock-approval"
WORLD_ENVIRONMENT=sandbox                # "sandbox" while testing (world-docs /world-id/sandbox/sandbox-access.mdx), "production" after

# --- Unlock ceremony approvers (Phase 6, FR-5.2) ---
# DEMO SHAPE. JSON map of {approverId: {address, authorizationPrivateKey}} for the
# five key-quorum members, so a single-machine demo can drive all five. In
# production each member is a Privy *user* signing with their own time-bound key
# (privy-docs /controls/authorization-keys/keys/create/user) and no member's key
# is ever on our server. See apps/web/src/app/api/unlock/[id]/approve/route.ts.
UNLOCK_APPROVER_KEYS=
